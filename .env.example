# --- App ---
# Public URL of the deployed app. In dev, leave blank — it's derived from PORT.
NEXT_PUBLIC_APP_URL=

# --- Database ---
# Postgres with the pgvector extension enabled. Neon's free tier works.
DATABASE_URL=

# --- Auth ---
# Random 32+ char string. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Composio ---
# Global API key for the Composio SDK. Get one at https://app.composio.dev/
COMPOSIO_API_KEY=
# Composio auth config ID for the Twitter toolkit (toolkit-level, not sign-in)
TWITTER_AUTH_CONFIG=

# --- LLM providers ---
# Anthropic API key (Claude — used as the agent's main model)
ANTHROPIC_API_KEY=
# OpenAI API key (used only for memory embeddings via text-embedding-3-large)
OPENAI_API_KEY=

# --- Telegram bot ---
# Create a bot via @BotFather to get the token + username
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random secret used to verify incoming Telegram webhook calls
TELEGRAM_WEBHOOK_SECRET=

# --- Redis ---
# Used for resumable streams, streaming state, and abort flags. Upstash works.
REDIS_URL=

# --- Cron ---
# Shared secret required by /api/cron/* routes. Generate with: openssl rand -hex 32
CRON_SECRET=
